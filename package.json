{
  "name": "still-player",
  "private": true,
  "version": "0.1.0",
  "main": "index.js",
  "scripts": {
    "postinstall": "node scripts/patch-vlc.cjs",
    "start": "expo start --dev-client",
    "typecheck": "tsc --noEmit",
    "build": "expo export --platform ios",
    "test": "vitest run",
    "check": "npm run typecheck && npm test && npm run build",
    "ios:configure": "expo prebuild --platform ios --no-install",
    "ios:build": "npx eas-cli build --platform ios --profile preview"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~54.0.38",
    "expo-crypto": "~15.0.9",
    "expo-dev-client": "~6.0.21",
    "expo-file-system": "~19.0.24",
    "expo-font": "~14.0.12",
    "expo-keep-awake": "~15.0.8",
    "expo-screen-orientation": "~9.0.9",
    "expo-secure-store": "~15.0.8",
    "expo-system-ui": "~6.0.9",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-vlc-media-player": "1.0.98"
  },
  "devDependencies": {
    "@types/react": "~19.1.10",
    "@types/node": "^22.10.0",
    "typescript": "~5.9.2",
    "vitest": "^3.2.0"
  }
}
